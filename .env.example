# Supabase (client)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Meta Conversions API — browser calls the edge function; token stays server-side.
# Deploy: supabase functions deploy meta-capi
# URL format: https://<project-ref>.supabase.co/functions/v1/meta-capi
VITE_META_CAPI_ENDPOINT=https://your-project.supabase.co/functions/v1/meta-capi

# --- Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets) ---
# META_PIXEL_ID=903780897993326
# META_CAPI_ACCESS_TOKEN=   # Events Manager → Pixel → Settings → Conversions API → Generate access token
# META_TEST_EVENT_CODE=     # Optional: Test events tab while QAing deduplication

# Google Ads conversion labels (optional; account IDs are in src/lib/analytics/googleAds.ts)
# VITE_GADS_LEAD_LABEL=           # homepage / BMS-owned forms → AW-18249809652
# VITE_GADS_RESHAB_LEAD_LABEL=DwI_CJ7i2MscEMezu5NE    # /thank-you + /automation-score/report → AW-18294430151

# Stripe (international digital package, $399) — Secret never in VITE_*
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxx    # optional; Checkout is hosted
# Supabase Edge Function secrets:
#   STRIPE_SECRET_KEY=sk_live_xxxxxxxx
#   STRIPE_PRODUCT_ID=prod_xxxxxxxx
#   STRIPE_PRICE_ID=price_xxxxxxxx               # optional; otherwise $399 is created from the product
#   STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx         # after adding the webhook in Stripe
# Webhook URL: https://khxkorrvylcscyqfklxi.supabase.co/functions/v1/stripe-webhook
# Events: checkout.session.completed, checkout.session.expired, checkout.session.async_payment_failed, payment_intent.payment_failed
# India → Razorpay; everywhere else → Stripe. Override with ?pay=razorpay or ?pay=stripe

# Razorpay (India /pay checkout) — Key ID is public; never put Key Secret in VITE_*
# VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxx          # also set in Vercel env
# Supabase Edge Function secrets (project khxkorrvylcscyqfklxi):
#   RAZORPAY_KEY_ID=
#   RAZORPAY_KEY_SECRET=
#   RAZORPAY_WEBHOOK_SECRET=
#   RESEND_API_KEY=                 # abandon + GST invoice emails
#   BMS_SELLER_GSTIN=               # required to email tax invoices
#   BMS_SELLER_LEGAL_NAME=          # optional; defaults to Triple Seven Boostmysites…
#   BMS_BILLING_FROM=               # optional; default Boostmysites Billing <billing@boostmysites.com>
#   SITE_ORIGIN=https://boostmysites.com
# Webhook URL: https://khxkorrvylcscyqfklxi.supabase.co/functions/v1/razorpay-webhook
# Abandon cron: razorpay-abandon-cron every 15m (pending > 60m)
