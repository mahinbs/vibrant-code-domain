{
  "crons": [
    {
      "path": "/api/daily-report",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/keep-alive",
      "schedule": "0 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/dashboard/lead/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|SkypeUriPreview|Google-PageRenderer).*"
        }
      ],
      "destination": "/api/lead-og?id=:id"
    },
    {
      "source": "/for-llm",
      "destination": "/for-llm/index.html"
    },
    {
      "source": "/app",
      "destination": "https://ailead-one.vercel.app/app"
    },
    {
      "source": "/app/:path*",
      "destination": "https://ailead-one.vercel.app/app/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://ailead-one.vercel.app/_next/:path*"
    },
    {
      "source": "/brand/:path*",
      "destination": "https://ailead-one.vercel.app/brand/:path*"
    },
    {
      "source": "/demo/:path*",
      "destination": "https://ailead-one.vercel.app/demo/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://ailead-one.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
