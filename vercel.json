{
  "crons": [
    {
      "path": "/api/daily-report",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/keep-alive",
      "schedule": "0 6 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/ai-calling",
      "destination": "/services/ai-calling",
      "permanent": true
    },
    {
      "source": "/partnership",
      "destination": "/partners",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/dashboard/lead/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|SkypeUriPreview|Google-PageRenderer).*"
        }
      ],
      "destination": "/api/lead-og?id=:id"
    },
    {
      "source": "/for-llm",
      "destination": "/for-llm/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app-shell.html"
    }
  ]
}
